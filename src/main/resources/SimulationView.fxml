<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.presenter.SimulationController"
            prefHeight="700.0" prefWidth="750.0">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #444444; -fx-padding: 5;">
                <Label text="Zoom:" textFill="WHITE" />
                <Slider fx:id="zoomSlider" min="600" max="2000" value="600" blockIncrement="50" />
                <Label text="Grid:" textFill="WHITE" />
                <CheckBox fx:id="showGridBox" selected="true" onAction="#onRedrawNeeded"/>
            </HBox>
        </top>

        <center>
            <ScrollPane fx:id="mapScrollPane" fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background: #333333; -fx-border-color: transparent;">
                <StackPane style="-fx-background-color: #333333;">
                    <Canvas fx:id="simulationCanvas" height="600.0" onMouseClicked="#onCanvasClicked" width="600.0" />
                </StackPane>
            </ScrollPane>
        </center>

        <bottom>
            <VBox spacing="5" style="-fx-background-color: #dddddd; -fx-padding: 10;" alignment="CENTER">
                <Label fx:id="statusLabel" text="Symulacja zatrzymana" style="-fx-font-weight: bold;"/>

                <HBox alignment="CENTER" spacing="15">
                    <Button text="&lt;&lt; Start" onAction="#onRewindToStart"/>
                    <Button text="&lt; Krok w tył" onAction="#onStepBack"/>
                    <Button fx:id="pauseButton" text="PAUZA ||" onAction="#onPauseClicked" prefWidth="100" style="-fx-base: #ffcccc;"/>
                    <Button fx:id="playButton" text="START &gt;" onAction="#onResumeClicked" prefWidth="100" style="-fx-base: #ccffcc;"/>
                    <Button text="Krok w przód &gt;" onAction="#onStepForward"/>
                    <Button text="Koniec &gt; &gt;" onAction="#onStepEnd"/>
                </HBox>
            </VBox>
        </bottom>

    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="250">
            <VBox spacing="10" style="-fx-background-color: #f4f4f4;">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>

                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Statystyki dnia" />
                <VBox spacing="5">
                    <Label fx:id="dayLabel" text="Dzień: 0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Label fx:id="allAnimalsLabel" text="Zwierzaki: 0" />
                    <Label fx:id="allPlantsLabel" text="Rośliny: 0" />
                    <Label fx:id="freeFieldsLabel" text="Wolne pola: 0" />
                    <Label fx:id="avgEnergyLabel" text="Śr. energia: 0" />
                    <Label fx:id="avgLifespanLabel" text="Śr. dł. życia: 0" />
                    <Label fx:id="avgChildrenCount" text="Śr. il. dzieci: 0" />
                </VBox>

                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Śledzony Zwierzak" />
                <Label fx:id="noAnimalSelectedLabel" text="(Kliknij na zwierzę, by śledzić)" />
                <VBox fx:id="animalStatsBox" spacing="5" visible="false">
                    <Label fx:id="trackedIdLabel" text="ID: -" />
                    <TextArea fx:id="trackedGenotypeArea"
                              editable="false"
                              wrapText="true"
                              prefRowCount="3"
                              prefWidth="200"
                              style="-fx-font-family: monospace;"/>
                    <Label fx:id="trackedActiveGeneLabel" text="Aktywny gen: -" />
                    <Label fx:id="trackedEnergyLabel" text="Energia: -" />
                    <Label fx:id="trackedPlantsLabel" text="Zjedzone rośliny: -" />
                    <Label fx:id="trackedChildrenLabel" text="Dzieci: -" />
                    <Label fx:id="trackedDescendantsLabel" text="Potomkowie: -" />
                    <Label fx:id="trackedAgeLabel" text="Wiek: -" />
                    <Label fx:id="trackedDeathLabel" text="Śmierć: -" textFill="RED"/>
                    <Button text="Przestań śledzić" onAction="#onStopTrackingClicked"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
